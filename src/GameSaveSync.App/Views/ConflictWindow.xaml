<Window x:Class="GameSaveSync.App.Views.ConflictWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="同步冲突" Height="580" Width="900"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource Md3.FontFamily}" FontSize="14"
        Background="{DynamicResource Md3.Surface}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock x:Name="HeaderText" Style="{StaticResource Md3.HeadlineSmall}" TextWrapping="Wrap" />
            <TextBlock Text="两台设备各自改过这个游戏，两个快照都完整保存在云端。请选择以哪一边为准（不会删除另一边，之后仍可从历史里恢复）。"
                       Style="{StaticResource Md3.BodySmall}" TextWrapping="Wrap" Margin="0,6,0,0" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Md3.FilledCard}" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="A 侧" Style="{StaticResource Md3.TitleMedium}" Margin="0,0,0,8" />
                        <TextBlock x:Name="LeftTime" Style="{StaticResource Md3.BodyMedium}" />
                        <TextBlock x:Name="LeftDevice" Style="{StaticResource Md3.BodySmall}" Margin="0,4,0,10" />
                        <Border Style="{StaticResource Md3.Divider}" Margin="0,0,0,10" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" Style="{StaticResource Md3.ScrollViewer}">
                        <TextBlock x:Name="LeftDiff" Style="{StaticResource Md3.BodySmall}"
                                   Foreground="{DynamicResource Md3.OnSurface}" TextWrapping="Wrap" />
                    </ScrollViewer>

                    <Button Grid.Row="2" Content="以 A 为准" Style="{StaticResource Md3.FilledButton}"
                            Click="ChooseLeft_OnClick" Margin="0,16,0,0" HorizontalAlignment="Left" />
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Md3.FilledCard}" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="B 侧" Style="{StaticResource Md3.TitleMedium}" Margin="0,0,0,8" />
                        <TextBlock x:Name="RightTime" Style="{StaticResource Md3.BodyMedium}" />
                        <TextBlock x:Name="RightDevice" Style="{StaticResource Md3.BodySmall}" Margin="0,4,0,10" />
                        <Border Style="{StaticResource Md3.Divider}" Margin="0,0,0,10" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" Style="{StaticResource Md3.ScrollViewer}">
                        <TextBlock x:Name="RightDiff" Style="{StaticResource Md3.BodySmall}"
                                   Foreground="{DynamicResource Md3.OnSurface}" TextWrapping="Wrap" />
                    </ScrollViewer>

                    <Button Grid.Row="2" Content="以 B 为准" Style="{StaticResource Md3.FilledButton}"
                            Click="ChooseRight_OnClick" Margin="0,16,0,0" HorizontalAlignment="Left" />
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="导出两侧 zip" Style="{StaticResource Md3.OutlinedButton}"
                    Click="ExportBoth_OnClick" MinWidth="130" Margin="0,0,8,0" />
            <Button Content="稍后处理" Style="{StaticResource Md3.TextButton}" Click="Cancel_OnClick" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
