<Window x:Class="GameSaveSync.App.Views.ProbeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GameSaveSync.App.ViewModels"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Reload — 探测存档目录" Width="820" Height="660"
        WindowStyle="None" Background="{DynamicResource Md3.SurfaceContainerLow}"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource Md3.FontFamily}"
        PreviewKeyDown="Window_OnPreviewKeyDown"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True">

    <!-- 圆角用 WindowChrome 而非 AllowsTransparency：
         layered window 会关闭 ClearType 子像素渲染（彩色边缘占比 58% → 9%），文字发糊。 -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0"
                            CornerRadius="28" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border CornerRadius="28" Background="{DynamicResource Md3.SurfaceContainerLow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="28,24,20,0"
                  Background="Transparent"
                  MouseLeftButtonDown="Title_OnMouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="探测存档目录" Style="{StaticResource Md3.HeadlineSmall}" />
                    <TextBlock Text="{Binding GameName, StringFormat=为「{0}」找出游戏真正写了哪些目录}"
                               Style="{StaticResource Md3.BodyMedium}" Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                               Margin="0,4,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource Md3.IconButton}"
                        Click="Close_OnClick" VerticalAlignment="Top">
                    <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource Md3.IconFont}" FontSize="16" />
                </Button>
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource Md3.FilledCard}" Margin="28,16,28,0" Padding="16,12">
                <StackPanel>
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Md3.BodyMedium}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ScannedText}" Style="{StaticResource Md3.LabelSmall}"
                               Margin="0,6,0,0" Foreground="{DynamicResource Md3.OnSurfaceVariant}" />
                    <Expander Header="查看要扫描的目录" Margin="0,8,0,0" FontSize="12">
                        <TextBlock Text="{Binding RootsText}" Style="{StaticResource Md3.BodySmall}"
                                   TextWrapping="Wrap" Margin="0,6,0,0" />
                    </Expander>
                </StackPanel>
            </Border>

            <Grid Grid.Row="2" Margin="28,14,28,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="开始探测" Style="{StaticResource Md3.TonalButton}"
                            Command="{Binding StartCommand}" Margin="0,0,8,0" />
                    <Button Content="完成探测并对比" Style="{StaticResource Md3.FilledButton}"
                            Command="{Binding CompleteCommand}" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding SelectedCount, StringFormat=已勾选 {0} 个}"
                               Style="{StaticResource Md3.LabelMedium}" VerticalAlignment="Center" />
                </StackPanel>

                <Border Grid.Row="1" Style="{StaticResource Md3.OutlinedCard}" Padding="6">
                    <Grid>
                        <ListBox ItemsSource="{Binding Candidates}" Style="{StaticResource Md3.ListBox}"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ProbeCandidateItem}">
                                    <Border CornerRadius="10" Padding="10,8" Margin="0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}"
                                                      VerticalAlignment="Center" />

                                            <StackPanel Grid.Column="1" Margin="10,0,12,0">
                                                <TextBlock Text="{Binding Directory}" Style="{StaticResource Md3.LabelLarge}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Reason}" Style="{StaticResource Md3.BodySmall}"
                                                           Margin="0,2,0,0" />
                                                <TextBlock Text="{Binding SampleText}" Style="{StaticResource Md3.LabelSmall}"
                                                           Foreground="{DynamicResource Md3.Outline}" Margin="0,2,0,0"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ScoreText, StringFormat=评分 {0}}"
                                                           Style="{StaticResource Md3.LabelMedium}"
                                                           HorizontalAlignment="Right" />
                                                <TextBlock Text="{Binding CountText}" Style="{StaticResource Md3.BodySmall}"
                                                           HorizontalAlignment="Right" Margin="0,2,0,0" />
                                                <TextBlock Text="{Binding SizeText}" Style="{StaticResource Md3.LabelSmall}"
                                                           HorizontalAlignment="Right" Foreground="{DynamicResource Md3.Outline}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                            <TextBlock Text="&#xE773;" FontFamily="{StaticResource Md3.IconFont}" FontSize="30"
                                       HorizontalAlignment="Center" Foreground="{DynamicResource Md3.Outline}" />
                            <TextBlock Text="先点「开始探测」，再去游戏里玩几分钟" Style="{StaticResource Md3.BodySmall}"
                                       HorizontalAlignment="Center" Margin="0,10,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="3" Margin="28,16,28,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="探测只读文件的时间戳与大小，不读取、也不修改存档内容。"
                           Style="{StaticResource Md3.BodySmall}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="取消" Style="{StaticResource Md3.TextButton}" Click="Close_OnClick" Margin="0,0,8,0" />
                    <Button Content="使用所选目录" Style="{StaticResource Md3.FilledButton}"
                            Command="{Binding UseSelectedCommand}" Click="Confirm_OnClick" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
