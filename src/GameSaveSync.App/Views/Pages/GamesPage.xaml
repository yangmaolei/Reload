<UserControl x:Class="GameSaveSync.App.Views.Pages.GamesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:GameSaveSync.App.ViewModels"
             xmlns:ctrl="clr-namespace:GameSaveSync.App.Views.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:MainViewModel}"
             Background="{DynamicResource Md3.Surface}">

    <UserControl.Resources>
        <!-- 带占位提示的搜索框 -->
        <Style x:Key="SearchBox" TargetType="TextBox" BasedOn="{StaticResource Md3.TextField}">
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="40,0,14,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border x:Name="Box" Background="{TemplateBinding Background}"
                                    CornerRadius="22" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1" />
                            <TextBlock Text="&#xE721;" FontFamily="{StaticResource Md3.IconFont}" FontSize="14"
                                       Margin="16,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Md3.OnSurfaceVariant}" />
                            <TextBlock x:Name="Hint" Text="搜索游戏" Margin="40,0,0,0"
                                       VerticalAlignment="Center" FontSize="14" Visibility="Collapsed"
                                       Foreground="{DynamicResource Md3.OnSurfaceVariant}" IsHitTestVisible="False" />
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" HorizontalScrollBarVisibility="Hidden" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Hint" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Md3.Primary}" />
                                <Setter TargetName="Box" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 卡片外壳按钮：整卡可点，悬停只加极淡的色层 -->
        <Style x:Key="CardButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <ContentPresenter />
                            <Border x:Name="Hover" CornerRadius="12" Background="{DynamicResource Md3.Primary}"
                                    Opacity="0" IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="0.04" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="0.08" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 时间线行 -->
        <Style x:Key="TimelineItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" Background="Transparent" CornerRadius="10"
                                Padding="6,6" Margin="0,1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background"
                                        Value="{DynamicResource Md3.SurfaceContainerHigh}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background"
                                        Value="{DynamicResource Md3.SecondaryContainer}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- ================= 卡片墙 ================= -->
        <Grid Visibility="{Binding IsWallVisible, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="28,24,28,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="我的游戏" Style="{StaticResource Md3.PageTitle}" />
                    <TextBlock Text="{Binding GamesSummary}" Style="{StaticResource Md3.BodySmall}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox Width="220" Style="{StaticResource SearchBox}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,0" />
                    <Button Style="{StaticResource Md3.TonalButton}"
                            Command="{Binding ScanGamesCommand}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE721;" FontFamily="{StaticResource Md3.IconFont}" FontSize="16" VerticalAlignment="Center" />
                            <TextBlock Text="扫描游戏" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Md3.FilledButton}" Command="{Binding AddGameCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="{StaticResource Md3.IconFont}" FontSize="13"
                                       VerticalAlignment="Center" Margin="0,0,8,0"
                                       Foreground="{DynamicResource Md3.OnPrimary}" />
                            <TextBlock Text="添加游戏" Foreground="{DynamicResource Md3.OnPrimary}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1" Style="{StaticResource Md3.ScrollViewer}" Margin="20,0,20,0">
                <Grid>
                    <ItemsControl ItemsSource="{Binding VisibleGames}" Margin="0,8,0,72">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:GameListItemViewModel}">
                                <!-- 整卡可点进入详情；海报区内的左右箭头是嵌套按钮，
                                     WPF 中内层按钮优先消费点击，不会冒泡到外层卡片。 -->
                                <Button Style="{StaticResource CardButton}"
                                        Command="{Binding DataContext.SelectGameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        AutomationProperties.Name="{Binding Name}">
                                    <Border Style="{StaticResource Md3.ElevatedCard}" Width="212" Padding="0">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- 海报区：竖屏长图 / 方形头图 两种形态可切换，
                                                 高度按形态宽高比自适应，等比缩放不变形。 -->
                                            <ctrl:PosterSwitcher Grid.Row="0" DataContext="{Binding}"
                                                                 Margin="10,10,10,0" />

                                            <Grid Grid.Row="1" Margin="12,10,12,12">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <DockPanel Grid.Row="0">
                                                    <Border DockPanel.Dock="Right" Style="{StaticResource Md3.Badge}"
                                                            Background="{Binding State, Converter={StaticResource StateToBrush}}">
                                                        <TextBlock Text="{Binding StateText}" FontSize="11"
                                                                   Foreground="{Binding State, Converter={StaticResource StateToBrush}, ConverterParameter=foreground}" />
                                                    </Border>
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Md3.TitleMedium}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </DockPanel>

                                                <TextBlock Grid.Row="1" Margin="0,2,0,0" Style="{StaticResource Md3.BodySmall}"
                                                           TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding PlatformText, Mode=OneWay}" />
                                                    <Run Text=" · " />
                                                    <Run Text="{Binding MetaText, Mode=OneWay}" />
                                                </TextBlock>

                                                <TextBlock Grid.Row="2" Text="{Binding RootSummary}" Margin="0,6,0,0"
                                                           Style="{StaticResource Md3.LabelSmall}"
                                                           Foreground="{DynamicResource Md3.Outline}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 空状态 -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,120"
                                Visibility="{Binding VisibleGames.Count, Converter={StaticResource CountToVisibility}}">
                        <Border Width="96" Height="96" CornerRadius="48"
                                Background="{DynamicResource Md3.PrimaryContainer}" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource Md3.IconFont}" FontSize="38"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Md3.OnPrimaryContainer}" />
                        </Border>
                        <TextBlock Text="还没有游戏" Style="{StaticResource Md3.HeadlineSmall}"
                                   HorizontalAlignment="Center" Margin="0,20,0,6" />
                        <TextBlock Text="自动识别 Steam / Epic / GOG / Ubisoft / Xbox 的游戏和存档目录"
                                   Style="{StaticResource Md3.BodyMedium}"
                                   Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                                   HorizontalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                            <Button Content="扫描已安装的游戏" Style="{StaticResource Md3.FilledButton}"
                                    Command="{Binding ScanGamesCommand}" Margin="0,0,10,0" />
                            <Button Style="{StaticResource Md3.OutlinedButton}"
                                    Command="{Binding AddGameCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="{StaticResource Md3.IconFont}" FontSize="16" VerticalAlignment="Center" />
                            <TextBlock Text="手动添加" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- ================= 详情 ================= -->
        <Grid Visibility="{Binding IsDetailVisible, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="24,18,24,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Style="{StaticResource Md3.IconButton}"
                        Command="{Binding BackToGamesCommand}" ToolTip="返回游戏列表"
                        VerticalAlignment="Top" Margin="0,6,4,0">
                    <TextBlock Text="&#xE72B;" FontFamily="{StaticResource Md3.IconFont}" FontSize="16" />
                </Button>

                <Grid Grid.Column="1" Width="120" Margin="4,0,0,0" VerticalAlignment="Top">
                    <!-- 海报切换组件：竖屏长图 / 方形头图 两种形态可切换，带过渡动画。
                         宽度固定 120，高度按形态宽高比自适应；图片 Stretch="Uniform" 等比缩放，
                         窄屏下宽度收窄时高度同步收缩，不裁切、不变形、不溢出。 -->
                    <ctrl:PosterSwitcher DataContext="{Binding SelectedGame}" />
                </Grid>

                <StackPanel Grid.Column="2" Margin="16,0,12,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding SelectedGame.Name}" Style="{StaticResource Md3.HeadlineSmall}"
                                   TextTrimming="CharacterEllipsis" />
                        <Border Style="{StaticResource Md3.Badge}" Margin="10,2,0,0"
                                Background="{Binding SelectedGame.State, Converter={StaticResource StateToBrush}}">
                            <TextBlock Text="{Binding SelectedGame.StateText}" FontSize="11"
                                       Foreground="{Binding SelectedGame.State, Converter={StaticResource StateToBrush}, ConverterParameter=foreground}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding SelectedGame.RootSummary}" Style="{StaticResource Md3.BodySmall}"
                               Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Style="{StaticResource Md3.FilledButton}"
                            Command="{Binding BackupCommand}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74E;" FontFamily="{StaticResource Md3.IconFont}" FontSize="16" VerticalAlignment="Center" />
                            <TextBlock Text="立即备份" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Content="恢复" Style="{StaticResource Md3.TonalButton}"
                            Command="{Binding RestoreCommand}" Margin="0,0,8,0" />
                    <Button Style="{StaticResource Md3.OutlinedButton}"
                            Command="{Binding ReloadSnapshotsCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="{StaticResource Md3.IconFont}" FontSize="16" VerticalAlignment="Center" />
                            <TextBlock Text="刷新" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <WrapPanel Grid.Row="1" HorizontalAlignment="Left" Margin="86,0,20,4">
                <Button Style="{StaticResource Md3.TextButton}" FontSize="12"
                        Command="{Binding ExportSnapshotCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEDE1;" FontFamily="{StaticResource Md3.IconFont}" FontSize="16" VerticalAlignment="Center" />
                            <TextBlock Text="导出 zip" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                <Button Style="{StaticResource Md3.TextButton}" FontSize="12"
                        Command="{Binding CleanupCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" FontFamily="{StaticResource Md3.IconFont}" FontSize="16" VerticalAlignment="Center" />
                            <TextBlock Text="清理旧快照" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                <Button Style="{StaticResource Md3.TextButton}" FontSize="12"
                        Command="{Binding RelocateCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource Md3.IconFont}" FontSize="16" VerticalAlignment="Center" />
                            <TextBlock Text="重新定位" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                <Button Style="{StaticResource Md3.TextButton}" FontSize="12"
                        Command="{Binding RefreshSavePathsCommand}"
                        IsEnabled="{Binding IsRefreshingSavePaths, Converter={StaticResource InverseBool}}"
                        ToolTip="重新从 PCGamingWiki 抓取该游戏的已知存档路径并覆盖现有配置">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" FontFamily="{StaticResource Md3.IconFont}" FontSize="16" VerticalAlignment="Center" />
                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="刷新存档路径">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="刷新存档路径" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRefreshingSavePaths}" Value="True">
                                            <Setter Property="Text" Value="刷新中…" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Md3.TextButton}" FontSize="12"
                        Foreground="{DynamicResource Md3.Error}" Command="{Binding ResolveConflictCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource Md3.IconFont}" FontSize="16" VerticalAlignment="Center" />
                            <TextBlock Text="处理冲突" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                <!-- 刷新存档路径的结果提示（成功/失败都留在这里，不随全局状态栏消失） -->
                <TextBlock Style="{StaticResource Md3.LabelSmall}"
                           Foreground="{DynamicResource Md3.Outline}"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0"
                           MaxWidth="420"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding RefreshSavePathsStatus}"
                           Visibility="{Binding RefreshSavePathsStatus, Converter={StaticResource TextToVisibility}}" />
                <Button Content="探测存档目录" Style="{StaticResource Md3.TextButton}" FontSize="12"
                        Command="{Binding ProbeCommand}" />
                <Button Style="{StaticResource Md3.TextButton}" FontSize="12"
                        Command="{Binding OpenSaveFolderCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE838;" FontFamily="{StaticResource Md3.IconFont}" FontSize="16" VerticalAlignment="Center" />
                            <TextBlock Text="打开存档目录" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                <Button Content="删除" Style="{StaticResource Md3.TextButton}" FontSize="12"
                        Foreground="{DynamicResource Md3.Error}" Command="{Binding RemoveGameCommand}" />
            </WrapPanel>

            <Grid Grid.Row="2" Margin="24,14,24,64">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="372" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 快照时间线 -->
                <Border Grid.Column="0" Style="{StaticResource Md3.FilledCard}" Padding="10,14,6,10">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="8,0,8,8">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Snapshots.Count, StringFormat={}{0} 个}"
                                       Style="{StaticResource Md3.LabelMedium}" />
                            <TextBlock Text="快照时间线" Style="{StaticResource Md3.TitleMedium}" />
                        </DockPanel>

                        <ListBox ItemsSource="{Binding Snapshots}"
                                 SelectedItem="{Binding SelectedSnapshot}"
                                 Style="{StaticResource Md3.ListBox}"
                                 ItemContainerStyle="{StaticResource TimelineItem}"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Grid Grid.Column="0">
                                            <Border Width="2" Background="{DynamicResource Md3.OutlineVariant}"
                                                    HorizontalAlignment="Center" Margin="0,14,0,0" />
                                            <Border Width="10" Height="10" CornerRadius="5"
                                                    Background="{DynamicResource Md3.Primary}"
                                                    VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                        </Grid>

                                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding StateText}"
                                                           Style="{StaticResource Md3.LabelSmall}"
                                                           Foreground="{DynamicResource Md3.OnSurfaceVariant}" />
                                                <TextBlock Style="{StaticResource Md3.LabelLarge}">
                                                    <Run Text="{Binding DateText, Mode=OneWay}" />
                                                    <Run Text=" " />
                                                    <Run Text="{Binding TimeText, Mode=OneWay}" />
                                                </TextBlock>
                                            </DockPanel>

                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="{Binding Snapshot.Trigger, Converter={StaticResource TriggerGlyph}}"
                                                           FontFamily="{StaticResource Md3.IconFont}" FontSize="11"
                                                           Foreground="{DynamicResource Md3.Primary}" Margin="0,0,6,0" />
                                                <TextBlock Text="{Binding TriggerText}" Style="{StaticResource Md3.BodySmall}" />
                                                <TextBlock Text=" · " Style="{StaticResource Md3.BodySmall}" />
                                                <TextBlock Text="{Binding FileCountText}" Style="{StaticResource Md3.BodySmall}" />
                                                <TextBlock Text=" · " Style="{StaticResource Md3.BodySmall}" />
                                                <TextBlock Text="{Binding SizeText}" Style="{StaticResource Md3.BodySmall}" />
                                            </StackPanel>

                                            <TextBlock Text="{Binding Note}" Style="{StaticResource Md3.BodySmall}"
                                                       Foreground="{DynamicResource Md3.Primary}" Margin="0,2,0,0"
                                                       TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- 差异视图 -->
                <Border Grid.Column="2" Style="{StaticResource Md3.OutlinedCard}" Padding="0">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="20,16,20,10">
                            <StackPanel>
                                <TextBlock Text="相对上一快照" Style="{StaticResource Md3.TitleMedium}" />
                                <TextBlock Text="{Binding DiffSummary}" Style="{StaticResource Md3.BodySmall}" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <Button Content="恢复到此时点" Style="{StaticResource Md3.FilledButton}"
                                        Command="{Binding RestoreCommand}" Margin="0,0,8,0" />
                                <Button Content="导出" Style="{StaticResource Md3.OutlinedButton}"
                                        Command="{Binding ExportSnapshotCommand}" />
                            </StackPanel>
                        </Grid>

                        <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource Md3.OutlineVariant}" Margin="20,0" />

                        <Grid DockPanel.Dock="Bottom" Margin="20,10,20,14">
                            <TextBlock Style="{StaticResource Md3.BodySmall}"
                                       Text="恢复前会自动创建 pre_restore 快照；恢复后仍可回到当时状态。" />
                        </Grid>

                        <ListBox ItemsSource="{Binding Diff.Entries}" Style="{StaticResource Md3.ListBox}"
                                 Margin="12,6,8,0" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VirtualizingPanel.IsVirtualizing="True">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Style="{StaticResource Md3.Chip}" Padding="8,1"
                                                Background="{Binding Kind, Converter={StaticResource DiffKindToBrush}}"
                                                MinWidth="42">
                                            <TextBlock Text="{Binding KindText}" FontSize="11"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{Binding Kind, Converter={StaticResource DiffKindToBrush}, ConverterParameter=foreground}" />
                                        </Border>

                                        <TextBlock Grid.Column="1" Text="{Binding RelPath}" Margin="10,0,10,0"
                                                   Style="{StaticResource Md3.BodySmall}"
                                                   Foreground="{DynamicResource Md3.OnSurface}"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />

                                        <TextBlock Grid.Column="2" Text="{Binding SizeDelta, Converter={StaticResource Bytes}}"
                                                   Style="{StaticResource Md3.LabelSmall}"
                                                   Foreground="{DynamicResource Md3.OnSurfaceVariant}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- 没有上一快照 / 内容相同 -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,30,0,0"
                                    Visibility="{Binding Diff.Entries.Count, Converter={StaticResource CountToVisibility}}">
                            <TextBlock Text="&#xE81C;" FontFamily="{StaticResource Md3.IconFont}" FontSize="26"
                                       HorizontalAlignment="Center" Foreground="{DynamicResource Md3.Outline}" />
                            <TextBlock Text="没有可显示的差异" Style="{StaticResource Md3.BodySmall}"
                                       HorizontalAlignment="Center" Margin="0,8,0,0" />
                            <TextBlock Text="选择左侧另一个快照，或先做一次备份" Style="{StaticResource Md3.LabelSmall}"
                                       HorizontalAlignment="Center" Foreground="{DynamicResource Md3.Outline}" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
