<Window x:Class="GameSaveSync.App.Views.RelocateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="重新定位存档目录" Height="480" Width="800"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource Md3.FontFamily}" FontSize="14"
        Background="{DynamicResource Md3.Surface}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock x:Name="HeaderText" Style="{StaticResource Md3.HeadlineSmall}" TextWrapping="Wrap" />
            <TextBlock Text="这些存档根在本机解析不到（游戏没装、或路径不一样）。请手动指定对应目录——工具不会猜路径，也不会把文件恢复到错误的位置。"
                       Style="{StaticResource Md3.BodySmall}" TextWrapping="Wrap" Margin="0,6,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Style="{StaticResource Md3.ScrollViewer}">
            <ItemsControl x:Name="RootList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Md3.FilledCard}" Padding="14" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="{Binding Token}" Style="{StaticResource Md3.LabelLarge}"
                                           TextWrapping="Wrap" />
                                <DockPanel Margin="0,8,0,0">
                                    <Button DockPanel.Dock="Right" Content="浏览…"
                                            Style="{StaticResource Md3.OutlinedButton}"
                                            Click="Browse_OnClick" Tag="{Binding}" Margin="8,0,0,0" />
                                    <TextBox Text="{Binding LocalPath, UpdateSourceTrigger=PropertyChanged}" />
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消" Style="{StaticResource Md3.TextButton}" Click="Cancel_OnClick" IsCancel="True"
                    Margin="0,0,8,0" />
            <Button Content="保存映射" Style="{StaticResource Md3.FilledButton}" Click="Ok_OnClick" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
