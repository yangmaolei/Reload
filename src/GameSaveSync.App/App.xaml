<Application x:Class="GameSaveSync.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:GameSaveSync.App.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Md3Tokens.xaml" />
                <ResourceDictionary Source="Themes/Md3Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:StateToBrushConverter x:Key="StateToBrush" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:InverseBoolConverter x:Key="InverseBool" />
            <conv:CountToVisibilityConverter x:Key="CountToVisibility" />
            <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
            <conv:TextToVisibilityConverter x:Key="TextToVisibility" />
            <conv:PageToVisibilityConverter x:Key="PageToVisibility" />
            <conv:TriggerGlyphConverter x:Key="TriggerGlyph" />
            <conv:InitialsConverter x:Key="Initials" />
            <conv:NameToBrushConverter x:Key="NameToBrush" />
            <conv:DiffKindToBrushConverter x:Key="DiffKindToBrush" />
            <conv:BytesConverter x:Key="Bytes" />
            <conv:LogLevelToBrushConverter x:Key="LogLevelToBrush" />
            <conv:HexToBrushConverter x:Key="HexToBrush" />
            <conv:RoundedClipConverter x:Key="RoundedClip" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
