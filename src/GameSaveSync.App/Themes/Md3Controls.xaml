<?xml version="1.0" encoding="utf-8"?>
<!--
  Material Design 3 · 控件样式
  只依赖 Md3Tokens.xaml 里的颜色/字体角色。所有可点击元素都带 state layer（悬停 8% / 按下 12%）。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========== 全局默认值 ========== -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Md3.FontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource Md3.OnSurface}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <Style TargetType="Window">
        <Setter Property="FontFamily" Value="{StaticResource Md3.FontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Background" Value="{DynamicResource Md3.Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource Md3.OnSurface}" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource Md3.InverseSurface}" />
        <Setter Property="Foreground" Value="{DynamicResource Md3.InverseOnSurface}" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== 按钮 ==========
         注意：ControlTemplate 里用 Binding Path 绑定"附加属性"是不可靠的 ——
         xmlns 别名在 Path 中不生效，clr-namespace:/程序集; 前缀在 Path 里是非法语法
         （抛 XamlParseException），写错时绑定静默失败并回退默认值。
         因此窗口按钮单独用一份模板，直接写死小圆角。
    -->
    <ControlTemplate x:Key="Md3.ButtonTemplate" TargetType="Button">
        <Grid SnapsToDevicePixels="True">
            <Border x:Name="Container"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="20" />
            <Border x:Name="StateLayer"
                    Background="{TemplateBinding Foreground}"
                    CornerRadius="20"
                    Opacity="0"
                    IsHitTestVisible="False" />
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              TextElement.Foreground="{TemplateBinding Foreground}"
                              TextElement.FontFamily="{TemplateBinding FontFamily}"
                              TextElement.FontSize="{TemplateBinding FontSize}"
                              TextElement.FontWeight="{TemplateBinding FontWeight}" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="StateLayer" Property="Opacity" Value="0.08" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="StateLayer" Property="Opacity" Value="0.14" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Container" Property="Opacity" Value="0.38" />
                <Setter TargetName="StateLayer" Property="Opacity" Value="0" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- 窗口按钮模板：扁平方形 + 小圆角。
         沿用主模板的 20 会被 WPF 钳成半圆（高 32 时 20 > 16），视觉上成了椭圆。 -->
    <ControlTemplate x:Key="Md3.WindowButtonTemplate" TargetType="Button">
        <Grid SnapsToDevicePixels="True">
            <Border x:Name="Container"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6" />
            <Border x:Name="StateLayer"
                    Background="{TemplateBinding Foreground}"
                    CornerRadius="6"
                    Opacity="0"
                    IsHitTestVisible="False" />
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              TextElement.Foreground="{TemplateBinding Foreground}"
                              TextElement.FontFamily="{TemplateBinding FontFamily}"
                              TextElement.FontSize="{TemplateBinding FontSize}"
                              TextElement.FontWeight="{TemplateBinding FontWeight}" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="StateLayer" Property="Opacity" Value="0.08" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="StateLayer" Property="Opacity" Value="0.14" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Container" Property="Opacity" Value="0.38" />
                <Setter TargetName="StateLayer" Property="Opacity" Value="0" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="Md3.ButtonBase" TargetType="Button">
        <Setter Property="Height" Value="40" />
        <Setter Property="MinWidth" Value="64" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Tag" Value="20" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template" Value="{StaticResource Md3.ButtonTemplate}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Md3.FilledButton" TargetType="Button" BasedOn="{StaticResource Md3.ButtonBase}">
        <Setter Property="Background" Value="{DynamicResource Md3.Primary}" />
        <Setter Property="Foreground" Value="{DynamicResource Md3.OnPrimary}" />
    </Style>

    <!-- MD3 单选：20 圆环 + 10 内圆点，选中环变 primary -->
    <Style x:Key="Md3.Radio" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Md3.OnSurface}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="20" Height="20" VerticalAlignment="Center">
                            <Ellipse x:Name="Ring" Width="20" Height="20"
                                     Stroke="{DynamicResource Md3.Outline}" StrokeThickness="2" Fill="Transparent" />
                            <Ellipse x:Name="Dot" Width="10" Height="10"
                                     Fill="{DynamicResource Md3.Primary}" Visibility="Collapsed" />
                        </Grid>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Md3.Primary}" />
                            <Setter TargetName="Ring" Property="StrokeThickness" Value="2" />
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Md3.Primary}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Md3.OutlineVariant}" />
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Md3.TonalButton" TargetType="Button" BasedOn="{StaticResource Md3.ButtonBase}">
        <Setter Property="Background" Value="{DynamicResource Md3.SecondaryContainer}" />
        <Setter Property="Foreground" Value="{DynamicResource Md3.OnSecondaryContainer}" />
    </Style>

    <Style x:Key="Md3.ElevatedButton" TargetType="Button" BasedOn="{StaticResource Md3.ButtonBase}">
        <Setter Property="Background" Value="{DynamicResource Md3.SurfaceContainerLowest}" />
        <Setter Property="Foreground" Value="{DynamicResource Md3.Primary}" />
        <Setter Property="Effect" Value="{StaticResource Md3.Elevation1}" />
    </Style>

    <Style x:Key="Md3.OutlinedButton" TargetType="Button" BasedOn="{StaticResource Md3.ButtonBase}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Md3.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Md3.OutlineVariant}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="Md3.TextButton" TargetType="Button" BasedOn="{StaticResource Md3.ButtonBase}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Md3.Primary}" />
        <Setter Property="Padding" Value="12,0" />
    </Style>

    <Style x:Key="Md3.DangerButton" TargetType="Button" BasedOn="{StaticResource Md3.ButtonBase}">
        <Setter Property="Background" Value="{DynamicResource Md3.Error}" />
        <Setter Property="Foreground" Value="{DynamicResource Md3.OnError}" />
    </Style>

    <Style x:Key="Md3.IconButton" TargetType="Button" BasedOn="{StaticResource Md3.ButtonBase}">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="MinWidth" Value="40" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Md3.OnSurfaceVariant}" />
        <Setter Property="Tag" Value="20" />
        <Setter Property="FontFamily" Value="{StaticResource Md3.IconFont}" />
        <Setter Property="FontSize" Value="16" />
    </Style>

    <Style x:Key="Md3.WindowButton" TargetType="Button" BasedOn="{StaticResource Md3.IconButton}">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="46" />
        <Setter Property="Tag" Value="6" />
        <Setter Property="Foreground" Value="{DynamicResource Md3.OnSurfaceVariant}" />
        <Setter Property="FontSize" Value="12" />
        <!-- 窗口按钮是扁平方形，用小圆角模板；主模板的 20 会被钳成半圆（看起来像椭圆） -->
        <Setter Property="Template" Value="{StaticResource Md3.WindowButtonTemplate}" />
    </Style>

    <Style x:Key="Md3.Fab" TargetType="Button" BasedOn="{StaticResource Md3.ButtonBase}">
        <Setter Property="Width" Value="56" />
        <Setter Property="Height" Value="56" />
        <Setter Property="MinWidth" Value="56" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Tag" Value="16" />
        <Setter Property="FontFamily" Value="{StaticResource Md3.IconFont}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="Background" Value="{DynamicResource Md3.PrimaryContainer}" />
        <Setter Property="Foreground" Value="{DynamicResource Md3.OnPrimaryContainer}" />
        <Setter Property="Effect" Value="{StaticResource Md3.Elevation2}" />
    </Style>

    <!-- 隐式按钮 = 文本按钮（主操作必须显式用 Filled/Tonal） -->
    <Style TargetType="Button" BasedOn="{StaticResource Md3.TextButton}" />

    <!-- ========== 卡片 ========== -->
    <Style x:Key="Md3.ElevatedCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Md3.SurfaceContainerLowest}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Effect" Value="{StaticResource Md3.Elevation1}" />
    </Style>

    <Style x:Key="Md3.FilledCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Md3.SurfaceContainerHigh}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="Md3.OutlinedCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Md3.SurfaceContainerLowest}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Md3.OutlineVariant}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- ========== Chip ========== -->
    <Style x:Key="Md3.Chip" TargetType="Border">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="Background" Value="{DynamicResource Md3.SurfaceContainerHigh}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Md3.Badge" TargetType="Border" BasedOn="{StaticResource Md3.Chip}">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="8,1" />
        <Setter Property="Background" Value="{DynamicResource Md3.SecondaryContainer}" />
    </Style>

    <!-- 兼容旧窗口的 Badge -->
    <Style x:Key="Badge" TargetType="Border" BasedOn="{StaticResource Md3.Chip}" />

    <Style x:Key="Md3.Divider" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource Md3.OutlineVariant}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ========== 文本输入（filled text field） ========== -->
    <Style x:Key="Md3.TextFieldBase" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource Md3.SurfaceContainerHighest}" />
        <Setter Property="Foreground" Value="{DynamicResource Md3.OnSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Md3.OnSurfaceVariant}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Md3.Primary}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Md3.PrimaryContainer}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Height" Value="52" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="Container"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" />
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"
                                      HorizontalScrollBarVisibility="Hidden" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Container" Property="BorderThickness" Value="2" />
                            <Setter TargetName="Container" Property="BorderBrush" Value="{DynamicResource Md3.Primary}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Container" Property="Background" Value="{DynamicResource Md3.SurfaceContainerHigh}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Container" Property="Opacity" Value="0.38" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Md3.TextField" TargetType="TextBox" BasedOn="{StaticResource Md3.TextFieldBase}" />

    <Style x:Key="Md3.MultilineField" TargetType="TextBox" BasedOn="{StaticResource Md3.TextFieldBase}">
        <Setter Property="Height" Value="Auto" />
        <Setter Property="MinHeight" Value="96" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    </Style>

    <Style TargetType="TextBox" BasedOn="{StaticResource Md3.TextField}" />

    <Style x:Key="Md3.PasswordField" TargetType="PasswordBox">
        <Setter Property="Background" Value="{DynamicResource Md3.SurfaceContainerHighest}" />
        <Setter Property="Foreground" Value="{DynamicResource Md3.OnSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Md3.OnSurfaceVariant}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Md3.Primary}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Md3.PrimaryContainer}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Height" Value="52" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Grid>
                        <Border x:Name="Container"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" />
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"
                                      HorizontalScrollBarVisibility="Hidden" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Container" Property="BorderThickness" Value="2" />
                            <Setter TargetName="Container" Property="BorderBrush" Value="{DynamicResource Md3.Primary}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Container" Property="Opacity" Value="0.38" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="PasswordBox" BasedOn="{StaticResource Md3.PasswordField}" />

    <!-- ========== 复选框 ========== -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Md3.OnSurface}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="18" Height="18" CornerRadius="3"
                                BorderBrush="{DynamicResource Md3.OnSurfaceVariant}" BorderThickness="2"
                                Background="Transparent" VerticalAlignment="Center">
                            <Path x:Name="Check" Data="M 2 8 L 6 12 L 14 3"
                                  Stroke="{DynamicResource Md3.OnPrimary}" StrokeThickness="2.2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Md3.Primary}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Md3.Primary}" />
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Md3.OnSurface}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== 开关（用于开机自启） ========== -->
    <Style x:Key="Md3.Switch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Track" Width="52" Height="32" CornerRadius="16"
                            Background="{DynamicResource Md3.SurfaceContainerHighest}"
                            BorderBrush="{DynamicResource Md3.Outline}" BorderThickness="2">
                        <Border x:Name="Thumb" Width="16" Height="16" CornerRadius="8"
                                Background="{DynamicResource Md3.Outline}"
                                HorizontalAlignment="Left" Margin="6,0,0,0" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Md3.Primary}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Md3.Primary}" />
                            <Setter TargetName="Thumb" Property="Width" Value="24" />
                            <Setter TargetName="Thumb" Property="Height" Value="24" />
                            <Setter TargetName="Thumb" Property="Background" Value="{DynamicResource Md3.OnPrimary}" />
                            <Setter TargetName="Thumb" Property="Margin" Value="22,0,0,0" />
                            <Setter TargetName="Track" Property="BorderThickness" Value="0" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== 导航栏 ========== -->
    <Style x:Key="Md3.NavItemContainer" TargetType="ListBoxItem">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border Background="Transparent">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Md3.NavRail" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0,8" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource Md3.NavItemContainer}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
    </Style>

    <!-- ========== 滚动条 ========== -->
    <Style x:Key="Md3.ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bar" Background="#8A6F7979" CornerRadius="3" Margin="3,0" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="#C06F7979" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}"
                               IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton x:Name="Decrease" Command="ScrollBar.PageUpCommand"
                                              Opacity="0" Focusable="False" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource Md3.ScrollThumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton x:Name="Increase" Command="ScrollBar.PageDownCommand"
                                              Opacity="0" Focusable="False" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Height" Value="10" />
                            <Setter Property="Width" Value="Auto" />
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                            <Setter TargetName="Decrease" Property="Command" Value="ScrollBar.PageLeftCommand" />
                            <Setter TargetName="Increase" Property="Command" Value="ScrollBar.PageRightCommand" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== 进度条 ========== -->
    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="4" />
        <Setter Property="Background" Value="{DynamicResource Md3.SurfaceContainerHighest}" />
        <Setter Property="Foreground" Value="{DynamicResource Md3.Primary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border Background="{TemplateBinding Background}" CornerRadius="2" />
                        <Border x:Name="PART_Track" Background="Transparent" />
                        <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                                CornerRadius="2" HorizontalAlignment="Left" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== 列表 ========== -->
    <Style x:Key="Md3.ListBox" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border Background="Transparent">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== 数据表格外观（日志/队列） ========== -->
    <Style x:Key="Md3.DataGrid" TargetType="DataGrid">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="RowBackground" Value="Transparent" />
        <Setter Property="AlternatingRowBackground" Value="Transparent" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Md3.OutlineVariant}" />
        <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="RowHeight" Value="34" />
        <Setter Property="ColumnHeaderHeight" Value="36" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserResizeRows" Value="False" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="Foreground" Value="{DynamicResource Md3.OnSurface}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- ========== 滚动区域 ========== -->
    <Style x:Key="Md3.ScrollViewer" TargetType="ScrollViewer">
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="PanningMode" Value="VerticalOnly" />
    </Style>

    <!-- ========== 分隔与标题 ========== -->
    <Style x:Key="Md3.PageTitle" TargetType="TextBlock" BasedOn="{StaticResource Md3.HeadlineMedium}">
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="Md3.SectionLabel" TargetType="TextBlock" BasedOn="{StaticResource Md3.LabelMedium}">
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <Style x:Key="Md3.FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Md3.LabelMedium}">
        <Setter Property="Margin" Value="2,0,0,6" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <Style x:Key="Md3.Hint" TargetType="TextBlock" BasedOn="{StaticResource Md3.BodySmall}">
        <Setter Property="Margin" Value="2,6,0,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

</ResourceDictionary>
