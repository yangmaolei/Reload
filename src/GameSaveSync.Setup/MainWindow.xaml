<Window x:Class="GameSaveSync.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:GameSaveSync.Setup"
        mc:Ignorable="d"
        Title="安装 Reload — 游戏存档同步"
        Height="560" Width="880"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="{DynamicResource Md3.Surface}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <Window.DataContext>
        <vm:SetupViewModel />
    </Window.DataContext>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============ 左侧品牌导航条 ============ -->
        <Border Grid.Column="0" Width="212" Background="{DynamicResource Md3.Primary}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Logo -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="24,28,0,0">
                    <Border Width="44" Height="44" CornerRadius="10"
                            Background="{DynamicResource Md3.OnPrimary}">
                        <TextBlock Text="R" FontSize="22" FontWeight="Medium"
                                   Foreground="{DynamicResource Md3.Primary}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Reload" FontSize="17" FontWeight="Medium"
                                   Foreground="{DynamicResource Md3.OnPrimary}" />
                        <TextBlock Text="游戏存档同步" FontSize="12"
                                   Foreground="{DynamicResource Md3.PrimaryContainer}" />
                    </StackPanel>
                </StackPanel>

                <!-- 步骤指示器 -->
                <ItemsControl Grid.Row="1" Margin="24,36,16,0" VerticalAlignment="Top">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="46">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- 圆点 -->
                                <Ellipse x:Name="Dot" Width="10" Height="10"
                                         VerticalAlignment="Top" Margin="0,4,0,0"
                                         Fill="{DynamicResource Md3.PrimaryContainer}" />

                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                    <TextBlock x:Name="StepTitle" FontSize="13"
                                               Foreground="{DynamicResource Md3.OnPrimary}"
                                               Text="{Binding Title}" />
                                    <TextBlock x:Name="StepHint" FontSize="11"
                                               Foreground="{DynamicResource Md3.PrimaryContainer}"
                                               Text="{Binding Hint}" TextWrapping="Wrap" Margin="0,1,0,0" />
                                </StackPanel>
                            </Grid>

                            <DataTemplate.Triggers>
                                <!-- 已走过的步骤：圆点变实心、文字全亮 -->
                                <DataTrigger Binding="{Binding IsReached}" Value="True">
                                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Md3.OnPrimary}" />
                                    <Setter TargetName="StepTitle" Property="Opacity" Value="1" />
                                    <Setter TargetName="StepHint" Property="Opacity" Value="1" />
                                </DataTrigger>

                                <!-- 当前步骤：标题加粗 -->
                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                    <Setter TargetName="StepTitle" Property="FontWeight" Value="Medium" />
                                    <Setter TargetName="Dot" Property="Width" Value="12" />
                                    <Setter TargetName="Dot" Property="Height" Value="12" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>

                    <ItemsControl.ItemsSource>
                        <Binding Path="StepList" />
                    </ItemsControl.ItemsSource>
                </ItemsControl>

                <!-- 底部版本 -->
                <StackPanel Grid.Row="2" Margin="24,0,16,20">
                    <TextBlock Text="版本 1.2.0" FontSize="11"
                               Foreground="{DynamicResource Md3.PrimaryContainer}" />
                    <TextBlock Text="MIT 许可证" FontSize="11" Margin="0,2,0,0"
                               Foreground="{DynamicResource Md3.PrimaryContainer}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ 右侧内容区 ============ -->
        <Grid Grid.Column="1" Margin="36,28,32,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 内容 -->
            <Grid Grid.Row="0">

                <!-- 欢迎 -->
                <StackPanel Visibility="{Binding Current, Converter={StaticResource SetupStepToVisibility}, ConverterParameter=Welcome}">
                    <TextBlock Text="欢迎使用 Reload" Style="{StaticResource Md3.HeadlineSmall}" />
                    <TextBlock Text="游戏存档备份与多设备同步工具。安装后即可自动备份你的游戏存档，并同步到你自己搭建的 WebDAV 云端。"
                               Style="{StaticResource Md3.BodyMedium}" Margin="0,10,0,0"
                               TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Left" />
                    <Border Style="{StaticResource Md3.OutlinedCard}" Margin="0,24,0,0"
                            Padding="16,14" MaxWidth="520" HorizontalAlignment="Left">
                        <StackPanel>
                            <TextBlock Text="安装说明" Style="{StaticResource Md3.LabelLarge}" />
                            <TextBlock Style="{StaticResource Md3.BodySmall}" Margin="0,6,0,0"
                                       TextWrapping="Wrap"
                                       Text="安装器会复制程序文件、创建桌面与开始菜单快捷方式，并在「应用和功能」中注册卸载项。数据保存在用户目录，卸载不会删除你的存档备份。" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 安装范围 -->
                <StackPanel Visibility="{Binding Current, Converter={StaticResource SetupStepToVisibility}, ConverterParameter=Scope}">
                    <TextBlock Text="为谁安装？" Style="{StaticResource Md3.HeadlineSmall}" />
                    <TextBlock Text="选择安装范围。若选择「所有用户」，安装过程会请求管理员权限。"
                               Style="{StaticResource Md3.BodyMedium}" Margin="0,10,0,0" TextWrapping="Wrap" />

                    <RadioButton Style="{StaticResource Md3.Radio}" GroupName="Scope"
                                 Margin="0,24,0,0" IsChecked="{Binding Scope, Converter={StaticResource ScopeToBool}, ConverterParameter=CurrentUser}">
                        <StackPanel Margin="8,4,0,0">
                            <TextBlock Text="仅当前用户" Style="{StaticResource Md3.LabelLarge}" />
                            <TextBlock Text="安装到你的用户目录，无需管理员权限，也不会弹出权限确认。"
                                       Style="{StaticResource Md3.BodySmall}" Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource Md3.Radio}" GroupName="Scope" Margin="0,16,0,0"
                                 IsChecked="{Binding Scope, Converter={StaticResource ScopeToBool}, ConverterParameter=AllUsers}">
                        <StackPanel Margin="8,4,0,0">
                            <TextBlock Text="所有用户" Style="{StaticResource Md3.LabelLarge}" />
                            <TextBlock Text="安装到 Program Files，本机所有用户都能使用。安装时会弹出管理员权限确认。"
                                       Style="{StaticResource Md3.BodySmall}" Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </RadioButton>

                    <Border Style="{StaticResource Md3.FilledCard}" Margin="0,20,0,0"
                            Padding="14,12" MaxWidth="520" HorizontalAlignment="Left"
                            Visibility="{Binding RequiresElevationNotice, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{StaticResource Md3.BodySmall}"
                                   Text="你选择了「所有用户」。点击「下一步」时会弹出 Windows 管理员权限确认窗口。"
                                   TextWrapping="Wrap" />
                    </Border>
                </StackPanel>

                <!-- 安装位置 -->
                <StackPanel Visibility="{Binding Current, Converter={StaticResource SetupStepToVisibility}, ConverterParameter=Location}">
                    <TextBlock Text="选择安装位置" Style="{StaticResource Md3.HeadlineSmall}" />
                    <TextBlock Text="程序文件将复制到以下目录。"
                               Style="{StaticResource Md3.BodyMedium}" Margin="0,10,0,0" TextWrapping="Wrap" />

                    <TextBlock Text="安装目录" Style="{StaticResource Md3.FieldLabel}" Margin="0,22,0,0" />
                    <TextBox Style="{StaticResource Md3.TextField}" Margin="0,8,0,0"
                             Text="{Binding InstallDirectory, UpdateSourceTrigger=PropertyChanged}"
                             MaxWidth="520" HorizontalAlignment="Left" />

                    <TextBlock Style="{StaticResource Md3.Hint}" Margin="0,8,0,0" TextWrapping="Wrap"
                               Visibility="{Binding DirectoryError, Converter={StaticResource TextToVisibility}}"
                               Foreground="{DynamicResource Md3.Error}" Text="{Binding DirectoryError}" />

                    <Border Style="{StaticResource Md3.OutlinedCard}" Margin="0,22,0,0"
                            Padding="14,12" MaxWidth="520" HorizontalAlignment="Left">
                        <StackPanel>
                            <TextBlock Text="提示" Style="{StaticResource Md3.LabelLarge}" />
                            <TextBlock Style="{StaticResource Md3.BodySmall}" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Text="你的存档数据始终保存在用户目录（%LOCALAPPDATA%\Reload），与安装目录无关。卸载程序不会删除存档备份。" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 安装选项 -->
                <StackPanel Visibility="{Binding Current, Converter={StaticResource SetupStepToVisibility}, ConverterParameter=Options}">
                    <TextBlock Text="安装选项" Style="{StaticResource Md3.HeadlineSmall}" />
                    <TextBlock Text="选择安装时要创建的快捷方式与启动项。"
                               Style="{StaticResource Md3.BodyMedium}" Margin="0,10,0,0" TextWrapping="Wrap" />

                    <Border Style="{StaticResource Md3.OutlinedCard}" Margin="0,22,0,0"
                            Padding="16,6" MaxWidth="520" HorizontalAlignment="Left">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,12,0,12">
                                <TextBlock Text="创建桌面与开始菜单快捷方式" Style="{StaticResource Md3.LabelLarge}" />
                                <TextBlock Text="方便随时启动 Reload" Style="{StaticResource Md3.BodySmall}" Margin="0,3,0,0" />
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource Md3.Switch}"
                                      IsChecked="{Binding CreateShortcut}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Md3.OutlinedCard}" Margin="0,12,0,0"
                            Padding="16,6" MaxWidth="520" HorizontalAlignment="Left">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,12,0,12">
                                <TextBlock Text="开机自动启动" Style="{StaticResource Md3.LabelLarge}" />
                                <TextBlock Text="登录后在托盘运行，继续做退出触发与空闲快照"
                                           Style="{StaticResource Md3.BodySmall}" Margin="0,3,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource Md3.Switch}"
                                      IsChecked="{Binding EnableAutoStart}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- 安装中 -->
                <StackPanel Visibility="{Binding Current, Converter={StaticResource SetupStepToVisibility}, ConverterParameter=Installing}">
                    <TextBlock Text="正在安装" Style="{StaticResource Md3.HeadlineSmall}" />
                    <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Md3.BodyMedium}"
                               Margin="0,10,0,0" TextWrapping="Wrap" />

                    <ProgressBar Height="6" Margin="0,22,0,0" Minimum="0" Maximum="100"
                                 Value="{Binding ProgressPercent, Mode=OneWay}"
                                 Foreground="{DynamicResource Md3.Primary}"
                                 Background="{DynamicResource Md3.SurfaceVariant}"
                                 BorderThickness="0" MaxWidth="520" HorizontalAlignment="Left" />

                    <ItemsControl Margin="0,22,0,0" MaxWidth="520" HorizontalAlignment="Left">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Ellipse Width="6" Height="6" Fill="{DynamicResource Md3.Primary}"
                                             VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBlock Text="{Binding}" Style="{StaticResource Md3.BodySmall}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.ItemsSource>
                            <Binding Path="CompletedSteps" />
                        </ItemsControl.ItemsSource>
                    </ItemsControl>
                </StackPanel>

                <!-- 完成 -->
                <StackPanel Visibility="{Binding Current, Converter={StaticResource SetupStepToVisibility}, ConverterParameter=Finished}">
                    <TextBlock Text="安装完成" Style="{StaticResource Md3.HeadlineSmall}"
                               Visibility="{Binding FinishedSuccessfully, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="安装未完成" Style="{StaticResource Md3.HeadlineSmall}"
                               Foreground="{DynamicResource Md3.Error}"
                               Visibility="{Binding FinishedSuccessfully, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />

                    <TextBlock Text="{Binding FinishedMessage}" Style="{StaticResource Md3.BodyMedium}"
                               Margin="0,12,0,0" TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Left" />

                    <TextBlock Style="{StaticResource Md3.BodySmall}" Margin="0,20,0,0" TextWrapping="Wrap"
                               MaxWidth="520" HorizontalAlignment="Left"
                               Visibility="{Binding FinishedSuccessfully, Converter={StaticResource BoolToVisibility}}"
                               Text="首次启动会引导你连接 WebDAV 云端并扫描已安装的游戏。你的存档数据保存在 %LOCALAPPDATA%\Reload，卸载程序不会删除它。" />
                </StackPanel>
            </Grid>

            <!-- 底部按钮栏 -->
            <Grid Grid.Row="1" Margin="0,24,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Style="{StaticResource Md3.TextButton}"
                        Content="取消" HorizontalAlignment="Left"
                        Click="OnCancelClick" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource Md3.OutlinedButton}" Content="上一步"
                            Margin="0,0,10,0" Click="OnBackClick"
                            Visibility="{Binding CanGoBack, Converter={StaticResource BoolToVisibility}}" />

                    <Button Click="OnNextClick"
                            IsEnabled="{Binding CanGoNext}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Md3.FilledButton}">
                                <Setter Property="Content" Value="下一步" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Current}" Value="Options">
                                        <Setter Property="Content" Value="安装" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsFinished}" Value="True">
                                        <Setter Property="Content" Value="完成" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
