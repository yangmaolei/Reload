<Application x:Class="GameSaveSync.Setup.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:GameSaveSync.Setup"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Md3Tokens.xaml" />
                <ResourceDictionary Source="Themes/Md3Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:SetupStepToVisibilityConverter x:Key="SetupStepToVisibility" />
            <conv:ScopeToBoolConverter x:Key="ScopeToBool" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:InverseBoolConverter x:Key="InverseBool" />
            <conv:TextToVisibilityConverter x:Key="TextToVisibility" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
